# Шаблон конфига для хостового nginx.
# Не редактируй результат руками — правь .env и перегенерируй:
#   ./deploy/render-nginx.sh
#
# Домен и порты подставляет render-nginx.sh из .env, поэтому порт живёт в одном
# месте и не может разъехаться с docker-compose. Блок listen для 443 он тоже
# собирает сам: отдельная директива http2 появилась только в nginx 1.25.1, а до
# неё http2 включался флагом прямо в listen.
#
# Имена плейсхолдеров тут намеренно не написаны: sed подставляет их по всему
# файлу, включая комментарии.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # По этому пути certbot подтверждает владение доменом при продлении.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
__LISTEN_443__
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    server_tokens off;

    # Совпадает с bodyLimit сервиса.
    client_max_body_size 5m;

    access_log /var/log/nginx/threads-api.access.log;
    error_log  /var/log/nginx/threads-api.error.log;

    # Открытый без параметров noVNC ищет WebSocket на /websockify от корня
    # сайта — мимо /vnc/ и мимо basic-auth, отчего «failed to connect».
    # Редирект подсказывает клиенту путь внутри /vnc/.
    location = /vnc/vnc.html {
        if ($args = "") {
            return 302 /vnc/vnc.html?path=vnc/websockify;
        }

        auth_basic           "Threads login session";
        auth_basic_user_file /etc/nginx/threads-novnc.htpasswd;

        proxy_pass http://127.0.0.1:__NOVNC_PORT__/vnc.html;
        proxy_http_version 1.1;
        proxy_set_header Host      $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Графический сеанс для ручного логина. Отвечает, только когда поднят
    # контейнер novnc. Всегда за basic-auth: это прямой доступ к браузеру,
    # залогиненному в твой аккаунт Threads.
    location /vnc/ {
        auth_basic           "Threads login session";
        auth_basic_user_file /etc/nginx/threads-novnc.htpasswd;

        proxy_pass http://127.0.0.1:__NOVNC_PORT__/;

        # noVNC живёт на WebSocket: без этих заголовков будет чёрный экран
        # вместо браузера.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;

        # Сеанс идёт минутами и простаивает, пока ты вводишь 2FA.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering    off;
    }

    location / {
        proxy_pass http://127.0.0.1:__API_PORT__;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Браузерные действия — чтение ленты со скроллом, ожидание обработки
        # видео — идут заметно дольше дефолтных 60 секунд.
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
        proxy_connect_timeout 10s;

        # Ответы небольшие и нужны целиком: буферизация только добавляет задержку.
        proxy_buffering off;
    }
}
