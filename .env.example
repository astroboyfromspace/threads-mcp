# ─── Доступ к сервису ────────────────────────────────────────────────────────

# Токен, которым агент авторизуется в этом сервисе. Придумай длинную случайную строку:
#   openssl rand -hex 32
API_TOKEN=

# ─── Приложение Threads ──────────────────────────────────────────────────────
# developers.facebook.com -> Мои приложения -> Use cases: Threads API
THREADS_APP_ID=
THREADS_APP_SECRET=
# Должен точь-в-точь совпадать с Redirect Callback URL в настройках приложения
THREADS_REDIRECT_URI=https://example.com/oauth/callback

# ─── Порты на хосте ──────────────────────────────────────────────────────────
# Единственное место, где задаются занимаемые на хосте порты. Дефолты взяты
# нестандартные, чтобы не столкнуться с соседними сервисами. Проверить, что
# они свободны: ./deploy/check-ports.sh
#
# Внутри контейнеров порты фиксированы (8080 и 6080) и ни с чем не конфликтуют:
# та сеть принадлежит только этому проекту.

# Интерфейс, на котором висят контейнеры. Менять на 0.0.0.0 не надо: наружу
# сервис отдаёт nginx, а прямой доступ в обход него — дыра.
API_BIND_ADDR=127.0.0.1

# Порт API. Сюда же смотрит proxy_pass в конфиге nginx.
API_BIND_PORT=18080

# Порт noVNC. Занят только на время ручного логина.
NOVNC_BIND_PORT=16080

# Домен, на котором отвечает nginx. Используется при генерации его конфига.
DOMAIN=example.com

# ─── Состояние ───────────────────────────────────────────────────────────────

# Каталог состояния: база, профиль браузера, скриншоты падений.
# В Docker переопределяется на /var/lib/threads-api.
DATA_DIR=./var

# Публичный адрес, по которому Threads сможет забрать загружаемые медиафайлы.
# Нужен только для постов с картинками/видео с локального диска.
PUBLIC_MEDIA_BASE_URL=

# ─── Поведение ───────────────────────────────────────────────────────────────

# Собственные суточные лимиты браузерных действий (защита аккаунта от бана)
LIMIT_LIKES_PER_DAY=150
LIMIT_FOLLOWS_PER_DAY=50
LIMIT_REPOSTS_PER_DAY=30

# Показывать окно браузера (для отладки через noVNC). В проде — false.
BROWSER_HEADED=false

# ─── Локальный запуск без Docker ─────────────────────────────────────────────
# В контейнере эти значения задаёт docker-compose, здесь они нужны только
# для `npm run dev` на своей машине.
HOST=127.0.0.1
PORT=8080
