# TLS Caddy выпускает и продлевает сам, ничего настраивать не нужно.
{$DOMAIN} {
	encode gzip

	# Графический сеанс для ручного логина. Доступен, только когда поднят
	# контейнер novnc, и всегда за basic-auth: это прямой доступ к браузеру,
	# залогиненному в твой аккаунт.
	handle_path /vnc/* {
		basic_auth {
			admin {$NOVNC_USER_HASH}
		}
		reverse_proxy novnc:6080
	}

	# Всё остальное — API. Авторизация bearer-токеном происходит в самом сервисе.
	handle {
		reverse_proxy api:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
